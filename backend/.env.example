# Reference only: keep the DATABASE_URL already in your local backend/.env.
DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DATABASE

# Enable YouTube Data API v3 in a Google Cloud project and create an API key.
# Put the real key only in your local backend/.env, which git already ignores.
YOUTUBE_API_KEY=replace_with_your_local_youtube_api_key
